# ==============================================================================
# ThreatSentinel - Environment Configuration Guide (.env.example)
# Theme: Smart India Hackathon (Blockchain + Cybersecurity - PS 26106)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT
# ------------------------------------------------------------------------------
PROJECT_NAME="ThreatSentinel Forensic Platform"
VERSION="1.0.0"
API_PREFIX="/api"
DEBUG=False

# Environment: "development" | "staging" | "production"
# In production, all demo tampering and database reset endpoints return 403 Forbidden.
ENVIRONMENT="development"
DEMO_MODE=True

# Ingestion Constraints (Max 15MB file upload limit)
MAX_UPLOAD_SIZE_BYTES=15728640

# ------------------------------------------------------------------------------
# 2. CORS SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Restrict strictly in production.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:8000"]

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
DATABASE_URL="sqlite:///./email_threat_platform.db"

# ------------------------------------------------------------------------------
# 4. BLOCKCHAIN FORENSIC EVIDENCE & CHAIN OF CUSTODY
# ------------------------------------------------------------------------------
# Enable or disable blockchain anchoring layer independently
BLOCKCHAIN_ENABLED=True

# Provider Mode: "local" (autonomous PoA validator) | "rpc" (EVM Hardhat/Ganache/Node)
BLOCKCHAIN_PROVIDER="local"
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"

# Smart Contract Addresses (EvidenceRegistry & ThreatIntelRegistry)
BLOCKCHAIN_CONTRACT_ADDRESS="0x71C80aB8B33f11E81D4b5b4Fe93C9a8Ec0F36D48"
BLOCKCHAIN_INTEL_CONTRACT_ADDRESS="0x89E23B84Ce1e6D403a7aE505d9b626E6F22eD33C"

# Validator Node & Network Metadata
BLOCKCHAIN_SYSTEM_ID="ThreatSentinel-Node-01"
BLOCKCHAIN_NETWORK="ThreatSentinel-PoA-LocalNet"

# ------------------------------------------------------------------------------
# 5. DECENTRALIZED THREAT INTELLIGENCE MODULE
# ------------------------------------------------------------------------------
THREAT_INTEL_ENABLED=True

# ------------------------------------------------------------------------------
# 6. OPTIONAL EXTERNAL AI/NLP SERVICES
# ------------------------------------------------------------------------------
# Leave empty to utilize built-in deterministic heuristic rule & NLP engines
GEMINI_API_KEY=""
