# ThreatSentinel Backend Environment Configuration
PROJECT_NAME="ThreatSentinel Forensic Platform"
VERSION="1.0.0"
API_PREFIX="/api"
DEBUG=True

# Ingestion Constraints
MAX_UPLOAD_SIZE_BYTES=15728640  # 15 MB

# CORS Settings (Comma-separated origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:8000"]

# Database
DATABASE_URL="sqlite:///./email_threat_platform.db"

# Optional Google Gemini 1.5 API Key (Leave empty to use built-in offline engine)
GEMINI_API_KEY=""
